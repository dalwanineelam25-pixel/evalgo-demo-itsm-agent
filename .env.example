# Copy to .env and adjust. Never commit a real key.

# fixture = scripted model (no API calls); real = Claude via langchain-anthropic
ITSM_MODEL_MODE=fixture
# Required in fixture mode for `itsm-agent chat` / `itsm-agent api`
ITSM_FIXTURE_SCRIPT=fixtures/scenarios/vpn_happy_path.json

# Real mode
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
MODEL=claude-opus-5-5
MODEL_EFFORT=medium
MODEL_MAX_TOKENS=16000
MODEL_TIMEOUT_S=120

# Local VPN diagnostic mock (itsm-agent diag-service)
DIAG_SERVICE_URL=http://127.0.0.1:8765
DIAG_TIMEOUT_S=5.0
DIAG_RETRIES=1
# How long the mock sleeps for scripted "timeout" devices
DIAG_MOCK_TIMEOUT_DELAY_S=30

# Storage (defaults under ./var)
# ITSM_DB_PATH=var/itsm.db
# ITSM_CHECKPOINT_DB_PATH=var/checkpoints.db
# ITSM_OUTBOX_PATH=var/outbox/notifications.jsonl
# ITSM_LOG_PATH=var/logs/itsm-agent.log
ITSM_RECURSION_LIMIT=40
LOG_LEVEL=INFO
